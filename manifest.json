{
  "manifest_version": 3,
  "name": "OfflineTTS",
  "version": "0.2.0",
  "description": "Read web pages and PDFs aloud with open source natural TTS voices (supertonic) - offline, private, and local",
  
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'"
  },
  
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "offscreen"
  ],
  
  "commands": {
    "play-pause": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Play/Pause reading"
    },
    "stop": {
      "suggested_key": {
        "default": "Alt+O"
      },
      "description": "Stop reading"
    },
    "skip-forward": {
      "suggested_key": {
        "default": "Alt+Period"
      },
      "description": "Skip forward"
    },
    "skip-back": {
      "suggested_key": {
        "default": "Alt+Comma"
      },
      "description": "Skip back"
    }
  },
  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*.wasm",
        "assets/onnx/*",
        "assets/voice_styles/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
